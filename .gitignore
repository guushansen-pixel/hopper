Thumbs.db
desktop.ini

# Godot (godot/ - siehe Migrationsplan): Editor-Cache und exportierte
# Binaerdateien gehoeren nicht ins Repo - APKs gehen als GitHub-Release-Asset
# raus, nicht in den Baum (dieselbe Lektion wie beim WebView-Build).
/godot/.godot/
*.apk
*.aab
*.pck

# Lokal per tests/screenshot_test.gd erzeugte Debug-Screenshots (+ Godots
# automatisch dazu erzeugte Import-Metadaten)
/godot/tests/*.png
/godot/tests/*.png.import
