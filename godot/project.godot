; Engine configuration file.
; Grundgeruest von new-godot-app.ps1 -Bootstrap erzeugt (Phase-0-
; Toolchain-Test), seit Phase 3 das echte Hopper-Godot-Projekt.

config_version=5

[application]

config/name="Hopper"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GDScript")

[display]

; Feste logische Aufloesung, auf die hopper_sim.gd fest verdrahtet ist
; (GROUND_Y=600, LW=620 - siehe dortiger Kommentar). "canvas_items"-Stretch
; skaliert das automatisch auf die tatsaechliche Geraete-/Fenstergroesse.
window/size/viewport_width=700
window/size/viewport_height=650
window/stretch/mode="canvas_items"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

; Phase 4: HDR2D + WorldEnvironment-Glow (siehe game_view.gd _setup_environment())
; - der eigentliche Grund fuer den Godot-Umstieg. Nur mit Forward+/Mobile
; wirksam (hier: "mobile", siehe oben).
viewport/hdr_2d=true

[autoload]

; Phase 5: 100% synthetisierte Sound-Effekte, ueberall per "Sfx.jump()" etc.
; erreichbar (siehe scripts/sfx.gd). Musik ist bewusst KEIN Autoload -
; game_view.gd haelt eine eigene music.gd-Instanz, da nur eine Szene sie
; braucht.
Sfx="*res://scripts/sfx.gd"

; Phase 6: Persistenz (Highscores/Einstellungen/Garderobe) unter user://,
; siehe scripts/save_data.gd.
Save="*res://scripts/save_data.gd"
