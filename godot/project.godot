; Engine configuration file.
; Grundgeruest von new-godot-app.ps1 -Bootstrap erzeugt (Phase-0-
; Toolchain-Test), seit Phase 3 das echte Hopper-Godot-Projekt.

config_version=5

[application]

config/name="Hopper"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GDScript")

[display]

; Feste logische Aufloesung, auf die hopper_sim.gd fest verdrahtet ist
; (GROUND_Y=600, LW=620 - siehe dortiger Kommentar). "canvas_items"-Stretch
; skaliert das automatisch auf die tatsaechliche Geraete-/Fenstergroesse.
window/size/viewport_width=700
window/size/viewport_height=650
window/stretch/mode="canvas_items"
window/handheld/orientation="portrait"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
